rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /publicMovies/{movieId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /publicFiles/{fileId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'type', 'size', 'url', 'path', 'protected', 'salt', 'iv', 'uploadedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 180
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 160
                    && request.resource.data.size is int
                    && request.resource.data.size >= 0
                    && request.resource.data.url is string
                    && request.resource.data.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
                    && request.resource.data.path is string
                    && request.resource.data.path.matches('public-drive/.*')
                    && request.resource.data.protected is bool
                    && request.resource.data.salt is string
                    && request.resource.data.salt.size() <= 32
                    && request.resource.data.iv is string
                    && request.resource.data.iv.size() <= 24
                    && (request.resource.data.protected == true
                        || (request.resource.data.salt == '' && request.resource.data.iv == ''))
                    && request.resource.data.uploadedAt == request.time;
      allow update: if false;
      allow delete: if resource.data.uploadedAt is timestamp
                    && resource.data.uploadedAt < request.time - duration.value(7, 'd');
    }
    match /healthcarePublicImages/{imageId} {
      allow get: if request.auth != null && resource.data.owner == request.auth.uid;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid
                  && request.query.limit <= 12;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['owner', 'image', 'createdAt'])
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.image is string
                    && request.resource.data.image.size() <= 400000
                    && request.resource.data.image.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}');
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Site-wide support and analytics; existing app rules above remain unchanged.
    function siteAdmin() {
      return request.auth != null
             && request.auth.token.get('email', '') == 'taithai5002@gmail.com'
             && request.auth.token.get('email_verified', false) == true;
    }
    function siteText(value, minimum, maximum) {
      return value is string
             && value.size() >= minimum && value.size() <= maximum
             && value.matches('[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]*')
             && (minimum == 0 || value.matches('(?s).*\\S.*'));
    }
    function siteId(value) {
      return value is string && value.matches('[A-Za-z0-9_-]{12,128}');
    }
    function siteStatus(value) {
      return value in ['open', 'in_progress', 'resolved', 'closed'];
    }
    function siteIdentity(uid, email) {
      return (request.auth == null && uid == '' && email == '')
             || (request.auth != null
                 && uid == request.auth.uid
                 && email == request.auth.token.get('email', ''));
    }
    function siteReportOwner() {
      return request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    function siteReportShape(data) {
      return data.keys().hasAll(['app', 'type', 'subject', 'description', 'steps', 'expected', 'contact',
                                'ownerUid', 'ownerEmail', 'ownerName', 'status', 'publicReply', 'createdAt', 'updatedAt'])
             && data.keys().hasOnly(['app', 'type', 'subject', 'description', 'steps', 'expected', 'contact',
                                    'ownerUid', 'ownerEmail', 'ownerName', 'status', 'publicReply', 'createdAt', 'updatedAt'])
             && siteText(data.app, 1, 80)
             && data.type in ['bug', 'complaint', 'feedback', 'privacy', 'accessibility']
             && siteText(data.subject, 5, 160)
             && siteText(data.description, 10, 6000)
             && siteText(data.steps, 0, 3000)
             && siteText(data.expected, 0, 3000)
             && siteText(data.contact, 0, 254)
             && siteText(data.ownerUid, 0, 128)
             && siteText(data.ownerEmail, 0, 254)
             && siteText(data.ownerName, 0, 160)
             && siteStatus(data.status)
             && siteText(data.publicReply, 0, 6000)
             && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function siteAppMode(data) {
      return data is map && data.keys().hasAll(['visibility']) && data.keys().hasOnly(['visibility'])
             && data.visibility in ['public', 'unlisted', 'private'];
    }
    function siteAppVisibilityShape(data) {
      return data.keys().hasAll(['schemaVersion', 'revision', 'apps', 'updatedAt', 'updatedBy'])
             && data.keys().hasOnly(['schemaVersion', 'revision', 'apps', 'updatedAt', 'updatedBy'])
             && data.schemaVersion == 1
             && data.revision is int && data.revision >= 1 && data.revision < 9007199254740991
             && data.updatedAt == request.time && data.updatedBy == 'owner'
             && data.apps is map
             && data.apps.keys().hasAll(['temporary-chat', 'qr-generator', 'qr-reader', 'shortlinks',
                  'bu-degree-plan', 'movie-memory', 'public-drive', 'chordly', 'ace', 'private-drive'])
             && data.apps.keys().hasOnly(['temporary-chat', 'qr-generator', 'qr-reader', 'shortlinks',
                  'bu-degree-plan', 'movie-memory', 'public-drive', 'chordly', 'ace', 'private-drive'])
             && siteAppMode(data.apps['temporary-chat']) && siteAppMode(data.apps['qr-generator'])
             && siteAppMode(data.apps['qr-reader']) && siteAppMode(data.apps['shortlinks'])
             && siteAppMode(data.apps['bu-degree-plan']) && siteAppMode(data.apps['movie-memory'])
             && siteAppMode(data.apps['public-drive']) && siteAppMode(data.apps['chordly'])
             && siteAppMode(data.apps['ace']) && siteAppMode(data.apps['private-drive'])
             && data.apps['private-drive'].visibility == 'private';
    }
    match /siteConfig/{configId} {
      // The visibility policy is public metadata, not an authorization credential.
      allow get: if configId == 'appVisibility';
      allow list, delete: if false;
      allow create: if configId == 'appVisibility' && siteAdmin()
                    && siteAppVisibilityShape(request.resource.data) && request.resource.data.revision == 1;
      allow update: if configId == 'appVisibility' && siteAdmin()
                    && siteAppVisibilityShape(request.resource.data)
                    && request.resource.data.revision == resource.data.revision + 1;
    }
    match /sitePrivateConfig/{configId} {
      allow get: if siteAdmin() && configId == 'privateDrive';
      allow list, create, update, delete: if false;
    }
    match /siteReports/{reportId} {
      allow create: if siteId(reportId)
                    && siteReportShape(request.resource.data)
                    && siteIdentity(request.resource.data.ownerUid, request.resource.data.ownerEmail)
                    && (request.auth != null || request.resource.data.ownerName == '')
                    && request.resource.data.status == 'open'
                    && request.resource.data.publicReply == ''
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow get: if siteAdmin() || siteReportOwner();
      allow list: if request.query.limit != null && request.query.limit <= 50
                  && (siteAdmin() || siteReportOwner());
      allow update: if siteAdmin()
                    && siteReportShape(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publicReply', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /siteEvents/{eventId} {
      allow create: if siteId(eventId)
                    && request.resource.data.keys().hasAll(['eventId', 'name', 'app', 'path', 'action', 'durationSeconds',
                       'device', 'clientAt', 'sessionId', 'actorUid', 'actorEmail', 'actorName', 'createdAt', 'consentVersion'])
                    && request.resource.data.keys().hasOnly(['eventId', 'name', 'app', 'path', 'action', 'durationSeconds',
                       'device', 'clientAt', 'sessionId', 'actorUid', 'actorEmail', 'actorName', 'createdAt', 'consentVersion'])
                    && request.resource.data.eventId == eventId
                    && request.resource.data.name in ['page_view', 'app_open', 'preference_change', 'report_submitted',
                       'help_view', 'signin', 'signout', 'click', 'heartbeat']
                    && siteText(request.resource.data.app, 1, 80)
                    && siteText(request.resource.data.path, 1, 240)
                    && request.resource.data.path.matches('/[^?#]*')
                    && !request.resource.data.path.matches('//.*')
                    && siteText(request.resource.data.action, 0, 80)
                    && request.resource.data.durationSeconds is int
                    && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 60
                    && request.resource.data.device in ['mobile', 'tablet', 'desktop']
                    && siteText(request.resource.data.clientAt, 20, 40)
                    && request.resource.data.clientAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z')
                    && siteId(request.resource.data.sessionId) && request.resource.data.sessionId.size() <= 64
                    && siteIdentity(request.resource.data.actorUid, request.resource.data.actorEmail)
                    && siteText(request.resource.data.actorUid, 0, 128)
                    && siteText(request.resource.data.actorEmail, 0, 254)
                    && siteText(request.resource.data.actorName, 0, 160)
                    && (request.auth != null || request.resource.data.actorName == '')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.consentVersion == 1;
      allow get: if siteAdmin();
      allow list: if siteAdmin() && request.query.limit != null && request.query.limit <= 500;
      allow update, delete: if false;
    }
    match /siteAdminAudit/{auditId} {
      allow create: if siteAdmin() && siteId(auditId)
                    && request.resource.data.keys().hasAll(['reportId', 'action', 'actorUid', 'actorEmail',
                       'fromStatus', 'toStatus', 'publicReply', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['reportId', 'action', 'actorUid', 'actorEmail',
                       'fromStatus', 'toStatus', 'publicReply', 'createdAt'])
                    && siteId(request.resource.data.reportId)
                    && request.resource.data.action == 'report_update'
                    && siteIdentity(request.resource.data.actorUid, request.resource.data.actorEmail)
                    && siteStatus(request.resource.data.fromStatus) && siteStatus(request.resource.data.toStatus)
                    && siteText(request.resource.data.publicReply, 0, 6000)
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/siteReports/$(request.resource.data.reportId))
                    && get(/databases/$(database)/documents/siteReports/$(request.resource.data.reportId)).data.status == request.resource.data.fromStatus
                    && getAfter(/databases/$(database)/documents/siteReports/$(request.resource.data.reportId)).data.status == request.resource.data.toStatus
                    && getAfter(/databases/$(database)/documents/siteReports/$(request.resource.data.reportId)).data.publicReply == request.resource.data.publicReply
                    && getAfter(/databases/$(database)/documents/siteReports/$(request.resource.data.reportId)).data.updatedAt == request.time;
      allow get: if siteAdmin();
      allow list: if siteAdmin() && request.query.limit != null && request.query.limit <= 50;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
