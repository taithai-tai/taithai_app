rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /publicMovies/{movieId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /publicFiles/{fileId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'type', 'size', 'url', 'path', 'protected', 'salt', 'iv', 'uploadedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 180
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 160
                    && request.resource.data.size is int
                    && request.resource.data.size >= 0
                    && request.resource.data.url is string
                    && request.resource.data.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
                    && request.resource.data.path is string
                    && request.resource.data.path.matches('public-drive/.*')
                    && request.resource.data.protected is bool
                    && request.resource.data.salt is string
                    && request.resource.data.salt.size() <= 32
                    && request.resource.data.iv is string
                    && request.resource.data.iv.size() <= 24
                    && (request.resource.data.protected == true
                        || (request.resource.data.salt == '' && request.resource.data.iv == ''))
                    && request.resource.data.uploadedAt == request.time;
      allow update: if false;
      allow delete: if resource.data.uploadedAt is timestamp
                    && resource.data.uploadedAt < request.time - duration.value(7, 'd');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
