# Server-side only. Configure the same name in the hosting provider environment settings.
OPENROUTER_API_KEY=

# Optional override. The app automatically falls back to openrouter/free.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Existing AI apps: preserve these server-only secrets when moving hosting.
NINEARM_API_KEY=
HEALTHCARE_PASSPORT_KEY=

# Membership / billing. Store credentials only in hosting provider secret environment variables.
# Prefer a Stripe restricted key (rk_), with only this integration's required permissions.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Separate product-scoped quantity confirmation portal; general portal must disable updates.
STRIPE_QUANTITY_PORTAL_CONFIGURATION_ID=
# Enable live upgrades only after stale/duplicate confirmation checks pass in Stripe Sandbox.
STRIPE_QUANTITY_UPDATES_VERIFIED=false
# JSON for the existing Firebase project and named database; server only.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use a base64-encoded service account JSON instead of the variable above.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Email hosting requires a provider account, domain verification and working DNS.
MAIL_PROVIDER=hostinger
MAIL_DOMAIN=taithai.app
# Hostinger management API token, with an existing paid/trial email order; never auto-buys seats.
HOSTINGER_API_TOKEN=
HOSTINGER_MAIL_ORDER_ID=
# Optional Purelymail alternative (set MAIL_PROVIDER=purelymail).
PURELYMAIL_API_TOKEN=
# Optional Migadu alternative (set MAIL_PROVIDER=migadu).
MIGADU_API_USER=
MIGADU_API_KEY=
# Persistent base64-encoded 32-byte encryption key. Back up securely; never rotate without migration.
MAIL_CREDENTIAL_SECRET=
# Enable after provider access/domain/DNS checks for a controlled owner trial.
# Public sales stay off until real receive/send and tenant isolation checks pass.
MAIL_READY=false
# Independent public-sales switch. Keep false throughout the owner email trial.
MEMBERSHIP_SALES_ENABLED=false
# Optional real-mail trial for the exact verified owner only; never grants a paid subscription.
OWNER_MAIL_TRIAL_ENABLED=false
# Required UTC ISO expiry for the owner trial, at most 31 days ahead (recommend 7 days).
OWNER_MAIL_TRIAL_EXPIRES_AT=
# Owner-only trial capacity (1 or 2). Actual provider seats are still required.
OWNER_MAIL_TRIAL_MAILBOXES=1
# Optional exact HTTPS <site>.netlify.app origin for owner-only mail trial writes; no wildcard.
OWNER_MAIL_TRIAL_ORIGIN=
