# Server-side only. Configure the same name in the hosting provider environment settings.
OPENROUTER_API_KEY=

# Optional override. The app automatically falls back to openrouter/free.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Existing AI apps remain on their current host; do not transfer these secrets for mail setup.
NINEARM_API_KEY=
HEALTHCARE_PASSPORT_KEY=

# Private administrator mail. Server secrets belong only in hosting secret settings.
# Payment endpoints and webhooks are disabled by code; Stripe keys are not needed.
# JSON for the existing Firebase project and named database; server only.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative base64 encoding; configure one service-account variable.
FIREBASE_SERVICE_ACCOUNT_BASE64=
MAIL_PROVIDER=hostinger
MAIL_DOMAIN=taithai.app
# Management API token and existing domain-attached order. Never auto-buys seats.
HOSTINGER_API_TOKEN=
HOSTINGER_MAIL_ORDER_ID=
# Persistent base64 32-byte encryption key. Back up; do not rotate without migration.
MAIL_CREDENTIAL_SECRET=
# Enable only after operator verification of provider access/domain/DNS.
MAIL_READY=false
# Historical flag name: enables permanent owner/delegated-admin mail, without billing/trial/expiry.
OWNER_MAIL_ENABLED=false
# Exact trusted HTTPS <site>.netlify.app origin for authenticated mail writes. No wildcard.
OWNER_MAIL_ORIGIN=https://taithai-app.netlify.app
# Kept false. The router disables billing even if this or old Stripe variables are present.
MEMBERSHIP_SALES_ENABLED=false

# Optional retained provider adapters; switching does not migrate saved mailboxes.
PURELYMAIL_API_TOKEN=
MIGADU_API_USER=
MIGADU_API_KEY=
