{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "proxy": {
    "entrypoint": "proxy.js"
  },
  "functions": {
    "api/ace.js": {
      "maxDuration": 150
    }
  },
  "headers": [
    {
      "source": "/firebase-auth.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/Chordly/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ACE/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ACE/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/taithai/news/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/account/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; connect-src 'self' https://www.gstatic.com https://*.googleapis.com https://accounts.google.com https://*.firebaseio.com https://*.firebasedatabase.app https://taithai-app.netlify.app; frame-src https://accounts.google.com https://*.firebaseapp.com; img-src 'self' data: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin/",
      "destination": "https://taithai-app.netlify.app/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*/",
      "destination": "https://taithai-app.netlify.app/admin/:path*/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://taithai-app.netlify.app/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://taithai-app.netlify.app/admin/:path*",
      "permanent": false
    },
    {
      "source": "/mail/",
      "destination": "https://taithai-app.netlify.app/mail/",
      "permanent": false
    },
    {
      "source": "/mail/:path*/",
      "destination": "https://taithai-app.netlify.app/mail/:path*/",
      "permanent": false
    },
    {
      "source": "/mail",
      "destination": "https://taithai-app.netlify.app/mail/",
      "permanent": false
    },
    {
      "source": "/mail/:path*",
      "destination": "https://taithai-app.netlify.app/mail/:path*",
      "permanent": false
    },
    {
      "source": "/taithai/new/",
      "destination": "/taithai/news/",
      "permanent": true
    },
    {
      "source": "/taithai/new/:path*",
      "destination": "/taithai/news/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/S/:code/",
      "destination": "/api/shortlinks/?code=:code"
    }
  ]
}
