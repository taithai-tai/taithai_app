{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/Movie-Memory/add/",
      "destination": "/Movie%20Memory/index.html"
    },
    {
      "source": "/Movie-Memory/movie/",
      "destination": "/Movie%20Memory/index.html"
    },
    {
      "source": "/Movie-Memory/settings/",
      "destination": "/Movie%20Memory/index.html"
    },
    {
      "source": "/Movie-Memory/posters/",
      "destination": "/Movie%20Memory/index.html"
    },
    {
      "source": "/Movie-Memory/:username/",
      "destination": "/Movie%20Memory/profile.html?username=:username"
    }
  ],
  "headers": [
    {
      "source": "/firebase-auth.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
